# Elysium Market Readiness — indexer configuration
# Copy to .env and adjust. Never commit .env.

RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
CHAIN_ID=99801
DATABASE_URL=postgresql://elysium:CHANGE_ME@localhost:5432/market_readiness

# First block to index when no checkpoint exists. Empty = genesis (0).
# NOTE: holder balances are only complete if indexing starts at or before
# each token's deployment block.
START_BLOCK=
BLOCK_BATCH_SIZE=2000
CONFIRMATION_BLOCKS=5

# Rate limit tuning for Elysium Testnet RPC
RPC_CONCURRENCY=2
RPC_RETRY_BASE_DELAY_MS=1500

LOG_LEVEL=info

# ---- Optional tuning (defaults shown) ----
# Stop after this block has been committed (useful for bounded scans). Empty = run forever.
STOP_BLOCK=
# Smallest range the adaptive eth_getLogs splitter may shrink to.
MIN_BLOCK_BATCH_SIZE=10
RPC_TIMEOUT_MS=20000
RPC_MAX_RETRIES=5
POLL_INTERVAL_MS=5000

# ---- Phase 3B: Onchain Attestation Configuration ----
# Deployed ElysiumAssessmentAttestation contract address on Elysium Testnet (Chain ID 99801)
ATTESTATION_CONTRACT_ADDRESS=
# Funded testnet attester private key (never commit, never log)
ATTESTER_PRIVATE_KEY=
